<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="igus_rebel">

	<!-- Set both at 0.0 if collapsing is not interested in gazebo -->
	<xacro:property name="damping" value="0.0" />
	<xacro:property name="friction" value="0.0" />

	<link name="world" />
	<joint name="world_joint" type="fixed">
		<parent link="world" />
		<child link="base_link" />
	</joint>

	<link name="base_link" />
	<joint name="base_link_to_igus_rebel" type="fixed">
		<parent link="base_link" />
		<child link="igus_rebel_base_link" />
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
	</joint>

	<material name="dark_grey">
		<color rgba="${25/255.0} ${25/255.0} ${25/255.0} 1.000" />
	</material>

	<link name="igus_rebel_base_link">
		<visual>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel/Joint0.dae" />
			</geometry>
			<material name="dark_grey" />
		</visual>
		<collision>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel_mod/Joint0.stl"
						scale="0.0001 0.0001 0.0001" />
			</geometry>
		</collision>
		<inertial>
			<mass value="1.0" />
			<inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
		</inertial>
	</link>

	<joint name="joint1" type="revolute">
		<parent link="igus_rebel_base_link" />
		<child link="link_1" />
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0 0.103" />
		<axis xyz="0 0 1" />
		<limit effort="330.0" lower="${-pi*179/180}" upper="${pi*179/180}" velocity="${pi/4.0}" />
		<dynamics damping="${damping}" friction="${friction}" />
	</joint>

	<link name="link_1">
		<visual>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel/Joint1.dae" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
			<material name="dark_grey" />
		</visual>
		<collision>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel_mod/Joint1.stl"
						scale="0.0001 0.0001 0.0001" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
		</collision>
		<inertial>
			<mass value="0.1" />
			<inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03" />
		</inertial>
	</link>

	<joint name="joint2" type="revolute">
		<parent link="link_1" />
		<child link="link_2" />
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.149" />
		<axis xyz="0 1 0" />
		<limit effort="330.0" lower="${-pi*80/180}" upper="${pi*140/180}" velocity="${pi/4.0}" />
		<dynamics damping="${damping}" friction="${friction}" />
	</joint>

	<link name="link_2">
		<visual>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel/Joint2.dae" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
			<material name="dark_grey" />
		</visual>
		<collision>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel_mod/Joint2.stl"
						scale="0.0001 0.0001 0.0001" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
		</collision>
		<inertial>
			<mass value="0.1" />
			<inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03" />
		</inertial>
	</link>

	<joint name="joint3" type="revolute">
		<parent link="link_2" />
		<child link="link_5" />
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.237" />
		<axis xyz="0 1 0" />
		<limit effort="330.0" lower="${-pi*80/180}" upper="${pi*140/180}" velocity="${pi/4.0}" />
		<dynamics damping="${damping}" friction="${friction}" />
	</joint>

	<link name="link_5">
		<visual>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel/Joint3.dae" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
			<material name="dark_grey" />
		</visual>
		<collision>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel_mod/Joint3.stl"
						scale="0.0001 0.0001 0.0001" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
		</collision>
		<inertial>
			<mass value="0.1" />
			<inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03" />
		</inertial>
	</link>

	<joint name="joint4" type="revolute">
		<parent link="link_5" />
		<child link="link_6" />
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.127" />
		<axis xyz="0 0 1" />
		<limit effort="330.0" lower="${-pi*179/180}" upper="${pi*179/180}" velocity="${pi/4.0}" />
		<dynamics damping="${damping}" friction="${friction}" />
	</joint>

	<link name="link_6">
		<visual>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel/Joint4.dae" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
			<material name="dark_grey" />
		</visual>
		<collision>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel_mod/Joint4.stl"
						scale="0.0001 0.0001 0.0001" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
		</collision>
		<inertial>
			<mass value="0.1" />
			<inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03" />
		</inertial>
	</link>

	<joint name="joint5" type="revolute">
		<parent link="link_6" />
		<child link="link_7" />
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.170" />
		<axis xyz="0 1 0" />
		<limit effort="330.0" lower="${-pi/2.0}" upper="${pi/2.0}" velocity="${pi/4.0}" />
		<dynamics damping="${damping}" friction="${friction}" />
	</joint>

	<link name="link_7">
		<visual>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel/Joint5.dae" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
			<material name="dark_grey" />
		</visual>
		<collision>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel_mod/Joint5.stl"
						scale="0.0001 0.0001 0.0001" />
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
		</collision>
		<inertial>
			<mass value="0.1" />
			<inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03" />
		</inertial>
	</link>

	<joint name="joint6" type="revolute">
		<parent link="link_7" />
		<child link="link_8" />
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0 0.126" />
		<axis xyz="0 0 1" />
		<limit effort="330.0" lower="${-pi*179/180}" upper="${pi*179/180}" velocity="${pi/4.0}" />
		<dynamics damping="${damping}" friction="${friction}" />
	</joint>

	<link name="link_8">
		<visual>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel/Joint6.dae" />
			</geometry>
			<origin rpy="0 0 0" xyz="0.0 0 0" />
			<material name="dark_grey" />
		</visual>
		<collision>
			<geometry>
				<mesh
						filename="file://$(find igus_rebel_description_ros2)/meshes/igus_rebel_mod/Joint6.stl"
						scale="0.0001 0.0001 0.0001" />
			</geometry>
			<origin rpy="0 0 0" xyz="0.0 0 0" />
		</collision>
		<inertial>
			<mass value="0.1" />
			<inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03" />
		</inertial>
	</link>

	<joint name="joint7" type="fixed">
		<parent link="link_8" />
		<child link="flange" />
		<origin rpy="0.0 ${-pi/2} 0.0" xyz="0.0 0.0 0.0" />
		<axis xyz="0 0 0" />
		<dynamics damping="${damping}" friction="${friction}" />
	</joint>

	<link name="flange" />

	<ros2_control name="igus_rebel" type="system">
		<hardware>
			<plugin>ign_ros2_control/IgnitionSystem</plugin>
		</hardware>

		<xacro:macro name="rebel_joint" params="name position_min=0 position_max=0 cri_joint_offset=0">
			<joint name="${name}">

				<command_interface name="velocity">
					<param name="min">${-pi/4}</param>
					<param name="max">${pi/4}</param>
				</command_interface>

				<state_interface name="position">
					<param name="initial_value">0.0</param>
				</state_interface>

				<state_interface name="velocity">
					<param name="initial_value">0.0</param>
				</state_interface>

				<!-- CRI specific parameters -->
				<param name="cri_joint_offset">${cri_joint_offset}</param>
			</joint>
		</xacro:macro>

		<!-- CRI joints offset for virtual zero definition -->

		<xacro:rebel_joint name="joint1" position_min="${-pi*179/180}"
						   position_max="${pi*179/180}" />
		<xacro:rebel_joint name="joint2" position_min="${-pi*2/3}" position_max="${pi*2/3}" />
		<xacro:rebel_joint name="joint3" position_min="${-pi*2/3}" position_max="${pi*2/3}" />
		<xacro:rebel_joint name="joint4" position_min="${-pi*179/180}"
						   position_max="${pi*179/180}" />
		<xacro:rebel_joint name="joint5" position_min="${-pi*19/36}" position_max="${pi*19/36}" />
		<xacro:rebel_joint name="joint6" position_min="${-pi*179/180}"
						   position_max="${pi*179/180}" />

	</ros2_control>

	<gazebo>
		<plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
			<parameters>$(find igus_rebel_moveit_config)/config/gazebo_controllers.yaml</parameters>
		</plugin>
	</gazebo>

</robot>